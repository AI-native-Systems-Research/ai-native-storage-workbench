diff -ruN '--exclude=*.trail' '--exclude=*.log' '--exclude=*.txt' '--exclude=trails' '--exclude=control' '--exclude=bug2' '--exclude=RESULT.md' orig/no-lost-extents/no_lost_extents_control.pml no-lost-extents/no_lost_extents_control.pml
--- orig/no-lost-extents/no_lost_extents_control.pml	1969-12-31 16:00:00.000000000 -0800
+++ no-lost-extents/no_lost_extents_control.pml	2026-10-17 00:50:33.264071864 -0700
@@ -0,0 +1,587 @@
+/* CONTROL copy of no_lost_extents.pml: identical model with the two minimal
+ * code fixes switched on (FIX_REMOVE, FIX_FREE_KEY). Generated by J20 from
+ * no_lost_extents.pml; regenerate rather than edit. */
+#define FIX_REMOVE   1
+#define FIX_FREE_KEY 1
+/*
+ * System-level model: No Lost Extents
+ *
+ * Verifies that every extent reservation (reserve_extent) is eventually
+ * followed by either publish() or abort/drop; that every PUBLISHED extent is
+ * still referenced by the dispatch-map at shutdown (otherwise nothing will
+ * ever call remove_extent on it: it is lost); and that every SSD offset the
+ * dispatch-map hands out points at a PUBLISHED extent of the same key.
+ *
+ * Code: origin/unstable @ acd24025 (citations re-derived by symbol, J20).
+ *
+ * Only ONE path creates extent reservations today (grep reserve_extent over
+ * components/: dispatcher/src/lib.rs:1439 is the only caller):
+ *   Background writer: DispatcherComponent::process_write_job
+ *     (dispatcher/src/lib.rs:1390-1465)
+ *     mt.peek None -> release_read, return             (lib.rs:1399-1405)
+ *     no drives -> convert_to_storage(key*4096)        (lib.rs:1407-1412)
+ *     DmaBuffer::from_raw Err -> release_read, return  (lib.rs:1422-1435)
+ *     reserve_extent Err -> release_read, return       (lib.rs:1439-1445)
+ *     write_buffer_to_ssd Err -> return, handle drops  (lib.rs:1451-1456)
+ *     let _ = write_handle.publish()                   (lib.rs:1463)
+ *     let _ = dm.convert_to_storage(key, offset)       (lib.rs:1464)
+ *   The old direct path (prepare_store/commit_store/cancel_store, the
+ *   pending_writes map cleared at shutdown) no longer exists: dispatcher spec
+ *   001 FR-020..FR-022 REMOVED 2026-07-02 (spec.md:297-299). It was removed
+ *   from the model together with ShutdownCleanup.
+ *
+ * Paths that free / repoint extents (modelled):
+ *   IDispatcher::remove         dispatcher/src/lib.rs:3096-3139
+ *   SSD evictor                 dispatcher/src/background.rs:313-349
+ *   MT evictor demote           dispatcher/src/background.rs:531-537
+ *                               (and evict_one_clean, lib.rs:1066-1071)
+ *   cold-load promote           dispatcher/src/lib.rs:903 ->
+ *                               dispatch-map/src/lib.rs:482-523
+ *   checkpoint flushes frees    extent-manager/src/lib.rs:313-320,
+ *                               region.rs:152-160
+ *   shutdown order              dispatcher/src/lib.rs:2112-2137
+ *
+ * Component wiring modeled:
+ *   Client -> Dispatcher (populate / cold load / remove)
+ *   Dispatcher -> BgWriter -> ExtentManager (reserve/publish/abort)
+ *   Dispatcher -> DispatchMap (release_read/convert_to_storage/remove)
+ *   Evictor (MT demote + SSD evict + periodic checkpoint)
+ *
+ * Safety properties:
+ *   P1: No extent is RESERVED after shutdown completes.
+ *   P2: (legacy, structural) ABORTED is never a resting state.
+ *   P3: An extent is RESERVED at most once (reserve only takes FREE slots).
+ *   P4: An errored write path always aborts (never leaves RESERVED).
+ *   P5: Only the WriteHandle holder publishes/aborts its reservation.
+ *   P6: Whenever the dispatch-map is given / holds an SSD offset, that offset
+ *       is a PUBLISHED extent holding the same key (no dangling offset).
+ *   P7: After shutdown every PUBLISHED extent is referenced by the
+ *       dispatch-map entry of its key (no orphaned = lost extent).
+ *
+ * Switches (all 0 = today's code):
+ *   FIX_REMOVE    1 = dm.remove reports the entry's SSD offset (BlockDevice
+ *                     offset or MemoryTier ssd_offset) and remove() frees it.
+ *   FIX_FREE_KEY  1 = the write-through skips publish/convert for key
+ *                     u64::MAX (or populate rejects it).
+ *   PUBLISH_ERR   1 = let publish() also return Err (the interface type
+ *                     allows it, iextent_manager.rs:132-139; today's only
+ *                     impl never does, extent-manager/src/lib.rs:597-616).
+ *
+ * Run:
+ *   spin -a no_lost_extents.pml
+ *   cc -O2 -DSAFETY -o pan pan.c
+ *   ./pan -m200000
+ */
+
+#ifndef FIX_REMOVE
+#define FIX_REMOVE   0
+#endif
+#ifndef FIX_FREE_KEY
+#define FIX_FREE_KEY 0
+#endif
+#ifndef PUBLISH_ERR
+#define PUBLISH_ERR  0
+#endif
+
+/* ---------- Parameters ---------- */
+#define N_CLIENTS       3   /* one key per client */
+#define N_EXTENTS       2   /* extent slots (< keys: OutOfSpace reachable) */
+#define QUEUE_CAP       3   /* bg_writer job queue (real: unbounded, background.rs:51) */
+#define FREE_KEY_CLIENT 2   /* client whose key is u64::MAX (FREE_KEY, slab.rs:5) */
+#define NO_OFF          255 /* no SSD offset / FREE_KEY in extent_key */
+#define BGW             255 /* extent owner id of the bg writer handle */
+
+/* ---------- Extent slot states ---------- */
+/* PENDING_FREE: remove_extent set key=FREE_KEY, bitmap still set until the
+ * next checkpoint flushes pending_frees (region.rs:121-160). */
+mtype = { FREE, RESERVED, PUBLISHED, ABORTED, PENDING_FREE };
+
+mtype extent_state[N_EXTENTS];
+byte  extent_owner[N_EXTENTS];   /* 0 = nobody, BGW = bg writer handle */
+byte  extent_key[N_EXTENTS];     /* key published in the slot, NO_OFF = FREE_KEY */
+
+/* ---------- Dispatch-map (dispatch-map/src/entry.rs:9-19) ---------- */
+mtype = { NONE, MT_NOSSD, MT_SSD, BLOCK };
+mtype dm_loc[N_CLIENTS];   /* NONE | MemoryTier{None} | MemoryTier{Some} | BlockDevice */
+byte  dm_off[N_CLIENTS];   /* ssd_offset / BlockDevice offset */
+byte  dm_rref[N_CLIENTS];  /* read_ref */
+
+/* ---------- Background writer channel ---------- */
+chan write_queue = [QUEUE_CAP] of { byte };
+
+/* ---------- Coordination ---------- */
+bool no_drives = false;    /* config: drives.is_empty() (lib.rs:1407) */
+byte clients_done = 0;
+bool shutdown = false;
+bool evictor_done = false;
+bool writer_done = false;
+
+/* ---------- Returned-value witnesses (set at the cited code line) ---------- */
+mtype = { R_OK, R_OK_DISCARDED, R_ERR, R_KEY_NOT_FOUND, R_INVALID_STATE,
+          R_OFFSET_NOT_FOUND, R_OUT_OF_SPACE };
+mtype last_reserve;   /* iem.reserve_extent()     lib.rs:1439 */
+mtype last_publish;   /* write_handle.publish()   lib.rs:1463 */
+mtype last_convert;   /* dm.convert_to_storage()  lib.rs:1410 / 1464 */
+mtype last_release;   /* dm.release_read()        lib.rs:1402/1432/1442/1454 */
+mtype last_rm_ext;    /* remove_extent()          lib.rs:3131, background.rs:348 */
+
+/* ---------- Extent Manager operations ---------- */
+
+/* reserve_extent (extent-manager/src/lib.rs:584-631): alloc_extent finds a
+ * free slot (region.rs:41-92) or returns OutOfSpace (region.rs:69,75,82).
+ * result = slot, or N_EXTENTS on Err(OutOfSpace). */
+inline reserve_extent(owner_id, result)
+{
+    atomic {
+        result = 0;
+        do
+        :: (result < N_EXTENTS) ->
+            if
+            :: (extent_state[result] == FREE) ->
+                extent_state[result] = RESERVED;     /* P3: only FREE slots */
+                extent_owner[result] = owner_id;
+                last_reserve = R_OK;
+                break
+            :: else ->
+                result++
+            fi
+        :: (result >= N_EXTENTS) ->
+            last_reserve = R_OUT_OF_SPACE;
+            break
+        od
+    }
+}
+
+/* WriteHandle::publish (iextent_manager.rs:132-139) -> publish_fn
+ * (extent-manager/src/lib.rs:597-616). abort_fn is taken first (l.137), so
+ * Drop does nothing afterwards.
+ *   key == FREE_KEY: free_slot, return Ok          (lib.rs:600-606)
+ *   otherwise:       publish_slot, return Ok       (lib.rs:609-614)
+ *   PUBLISH_ERR:     return Err, slot untouched    (allowed by the type only) */
+inline publish_extent(slot, owner_id, key)
+{
+    atomic {
+        assert(extent_state[slot] == RESERVED);   /* P5 */
+        assert(extent_owner[slot] == owner_id);   /* P5 */
+        if
+        :: (key == FREE_KEY_CLIENT) ->
+            extent_state[slot] = FREE;
+            extent_owner[slot] = 0;
+            extent_key[slot] = NO_OFF;
+            last_publish = R_OK_DISCARDED
+        :: else ->
+#if PUBLISH_ERR
+            if
+            :: true ->
+#endif
+                extent_state[slot] = PUBLISHED;
+                extent_owner[slot] = 0;
+                extent_key[slot] = key;
+                last_publish = R_OK
+#if PUBLISH_ERR
+            :: true ->
+                last_publish = R_ERR   /* abort_fn already taken: stays RESERVED */
+            fi
+#endif
+        fi
+    }
+}
+
+/* WriteHandle drop -> abort_fn -> free_slot (iextent_manager.rs:149-155,
+ * extent-manager/src/lib.rs:618-621). */
+inline abort_extent(slot, owner_id)
+{
+    atomic {
+        assert(extent_state[slot] == RESERVED);   /* P4/P5 */
+        assert(extent_owner[slot] == owner_id);
+        extent_state[slot] = FREE;
+        extent_owner[slot] = 0;
+        extent_key[slot] = NO_OFF
+    }
+}
+
+/* remove_extent (extent-manager/src/lib.rs:680-684 -> region.rs:121-150):
+ * Err(OffsetNotFound) unless bitmap set and key != FREE_KEY (region.rs:137);
+ * it does NOT check which key owns the slot. Caller is key k. Result is
+ * discarded by both callers (lib.rs:3131, background.rs:348). */
+inline remove_extent(off, k)
+{
+    atomic {
+        if
+        :: (extent_state[off] == PUBLISHED) ->
+            extent_state[off] = PENDING_FREE;
+            extent_key[off] = NO_OFF;
+            last_rm_ext = R_OK
+        :: else ->
+            last_rm_ext = R_OFFSET_NOT_FOUND
+        fi;
+        /* P6: the offset came from k's map entry, so it is k's live extent. */
+        assert(last_rm_ext == R_OK)
+    }
+}
+
+/* checkpoint -> flush_pending_frees (extent-manager/src/lib.rs:313-320). */
+inline checkpoint()
+{
+    atomic {
+        ci = 0;
+        do
+        :: (ci < N_EXTENTS) ->
+            if
+            :: (extent_state[ci] == PENDING_FREE) -> extent_state[ci] = FREE
+            :: else -> skip
+            fi;
+            ci++
+        :: else -> break
+        od;
+        ci = 0
+    }
+}
+
+/* dm.release_read (dispatch-map/src/lib.rs:267-285). On the write-through
+ * path the job holds the read ref taken by downgrade_reference, so the Err
+ * results (KeyNotFound l.272, RefCountUnderflow l.274-276) must not occur. */
+inline release_read(k)
+{
+    atomic {
+        if
+        :: (dm_loc[k] == NONE) -> last_release = R_KEY_NOT_FOUND
+        :: (dm_loc[k] != NONE && dm_rref[k] == 0) -> last_release = R_ERR
+        :: else -> dm_rref[k]--; last_release = R_OK
+        fi;
+        assert(last_release == R_OK)
+    }
+}
+
+/* dm.convert_to_storage (dispatch-map/src/lib.rs:176-208):
+ * KeyNotFound l.181, InvalidState if BlockDevice l.187-191, else sets
+ * ssd_offset (l.184-185) and drops one read ref (l.194-196). */
+inline convert_to_storage(k, off)
+{
+    atomic {
+        if
+        :: (dm_loc[k] == NONE)  -> last_convert = R_KEY_NOT_FOUND
+        :: (dm_loc[k] == BLOCK) -> last_convert = R_INVALID_STATE
+        :: else ->
+            dm_loc[k] = MT_SSD;
+            dm_off[k] = off;
+            if :: (dm_rref[k] > 0) -> dm_rref[k]-- :: else -> skip fi;
+            last_convert = R_OK
+        fi;
+        /* Result discarded (`let _`) in code; the entry is held by our read
+         * ref, so only Ok is expected. */
+        assert(last_convert == R_OK);
+        /* P6 (with drives: the offset must be k's published extent) */
+        assert(no_drives || (extent_state[off] == PUBLISHED && extent_key[off] == k))
+    }
+}
+
+/* ---------- Client process ---------- */
+/*
+ * populate (dispatcher/src/lib.rs:3143-3200 -> copy_gpu_to_memory_completed
+ * 3489-3569): create_memory_tier_entry (write_ref=1, l.3508) +
+ * downgrade_reference (write_ref=0, read_ref=1, l.3552) + enqueue WriteJob
+ * (l.3559-3566). Then optionally a cold load (promote) and/or remove.
+ */
+proctype Client(byte k)
+{
+    byte boff;
+
+    /* --- populate --- */
+    if
+    :: true ->
+        /* reserve_memory AllocationFailed -> best-effort drop, Ok(())
+         * (lib.rs:3160-3174). No entry, no job. */
+        skip
+    :: true ->
+        atomic {
+            dm_loc[k] = MT_NOSSD;
+            dm_off[k] = NO_OFF;
+            dm_rref[k] = 1
+        };
+        write_queue ! k
+    fi;
+
+    /* --- cold load: BlockDevice -> promote_block_to_memory_tier keeps the
+     * SSD offset (dispatch-map/src/lib.rs:482-523; dispatcher lib.rs:903).
+     * MemoryTier hit / NotExist change nothing relevant here. --- */
+    if
+    :: true -> skip
+    :: true ->
+        atomic {
+            if
+            :: (dm_loc[k] == BLOCK) -> dm_loc[k] = MT_SSD
+            :: else -> skip
+            fi
+        }
+    fi;
+
+    /* --- IDispatcher::remove (dispatcher/src/lib.rs:3096-3139) --- */
+    if
+    :: true -> skip
+    :: true ->
+#if FIX_REMOVE
+        /* Fix: dm.remove reports the SSD offset of the removed entry
+         * (BlockDevice offset or MemoryTier ssd_offset), under the map lock. */
+        atomic {
+            if
+            :: (dm_loc[k] == NONE) -> goto done                    /* KeyNotFound */
+            :: (dm_loc[k] != NONE && dm_rref[k] > 0) -> goto done  /* ActiveReferences */
+            :: else ->
+                boff = dm_off[k];
+                dm_loc[k] = NONE;
+                dm_off[k] = NO_OFF
+            fi
+        };
+#else
+        /* 1. dm.lookup: BlockDevice -> Some(offset); MemoryTier / NotExist
+         *    -> None (l.3105-3116). */
+        atomic {
+            if
+            :: (dm_loc[k] == BLOCK) -> boff = dm_off[k]
+            :: else -> boff = NO_OFF
+            fi
+        };
+        /* 2. dm.remove (l.3119-3120; dispatch-map/src/lib.rs:334-358):
+         *    KeyNotFound / ActiveReferences -> Err(KeyNotFound) to caller. */
+        atomic {
+            if
+            :: (dm_loc[k] == NONE) -> goto done
+            :: (dm_loc[k] != NONE && dm_rref[k] > 0) -> goto done
+            :: else ->
+                dm_loc[k] = NONE;
+                dm_off[k] = NO_OFF
+            fi
+        };
+#endif
+        /* 3. mt.remove (l.3123-3125): not relevant to extents.
+         * 4. remove_extent on drive_index(key) if Some(offset) (l.3127-3133).
+         *    With no drives, drives.get(idx) is None: nothing freed. */
+        if
+        :: (boff != NO_OFF && !no_drives) -> remove_extent(boff, k)
+        :: else -> skip
+        fi
+    fi;
+done:
+    clients_done++
+}
+
+/* ---------- Background Writer process ---------- */
+/* worker_loop (background.rs:117-143) running process_write_job
+ * (dispatcher/src/lib.rs:1390-1465); drains the channel on shutdown
+ * (background.rs:131-137). */
+proctype BgWriter()
+{
+    byte k;
+    byte slot;
+
+    do
+    :: write_queue ? k ->
+        if
+        :: true ->
+            /* mt.peek None (entry dropped from the memory-tier) ->
+             * release_read, return (lib.rs:1399-1405). */
+            release_read(k)
+        :: no_drives ->
+            /* synthetic offset key*4096, no extent (lib.rs:1407-1412) */
+            slot = k;
+            convert_to_storage(k, slot)
+        :: !no_drives ->
+            if
+            :: true ->
+                /* DmaBuffer::from_raw Err (null ptr / len 0,
+                 * interfaces/src/spdk_types.rs:293-308) -> release_read
+                 * (lib.rs:1431-1434). */
+                release_read(k)
+            :: true ->
+                reserve_extent(BGW, slot);   /* lib.rs:1439 */
+                if
+                :: (slot >= N_EXTENTS) ->
+                    /* Err(OutOfSpace): no handle, release_read, return
+                     * (lib.rs:1441-1444). */
+                    assert(last_reserve == R_OUT_OF_SPACE);
+                    release_read(k)
+                :: (slot < N_EXTENTS) ->
+                    assert(last_reserve == R_OK);
+                    if
+                    :: true ->
+                        /* write_buffer_to_ssd Ok -> publish (l.1463), result
+                         * discarded, then convert_to_storage (l.1464). */
+                        publish_extent(slot, BGW, k);
+#if FIX_FREE_KEY
+                        if
+                        :: (k == FREE_KEY_CLIENT) -> release_read(k)
+                        :: else -> convert_to_storage(k, slot)
+                        fi;
+#else
+                        convert_to_storage(k, slot);
+#endif
+                        /* publish result is discarded (`let _`, l.1463) and
+                         * convert_to_storage runs regardless: only a stored
+                         * Ok may reach this point. */
+                        assert(k == FREE_KEY_CLIENT || last_publish == R_OK)
+                    :: true ->
+                        /* write_buffer_to_ssd Err -> release_read, return;
+                         * write_handle dropped -> abort (lib.rs:1451-1456). */
+                        release_read(k);
+                        abort_extent(slot, BGW)
+                    fi
+                fi
+            fi
+        fi;
+        slot = 0
+    :: shutdown && empty(write_queue) ->
+        break
+    od;
+    writer_done = true
+}
+
+/* ---------- Evictors + periodic checkpoint ---------- */
+proctype Evictor()
+{
+    byte k;
+    byte off;
+    byte ci;
+
+    do
+    :: !shutdown ->
+        if
+        :: true ->
+            /* MT demote: try_evict_to_block (dispatch-map/src/lib.rs:548-577)
+             * Ok only if read_ref==0 && write_ref==0 && ssd_offset Some.
+             * Candidate key picked nondeterministically (oldest_keys). */
+            atomic {
+                k = 0;
+                do
+                :: (k < N_CLIENTS - 1) -> k++
+                :: true -> break
+                od;
+                if
+                :: (dm_loc[k] == MT_SSD && dm_rref[k] == 0) -> dm_loc[k] = BLOCK
+                :: else -> skip   /* ActiveReferences / InvalidState */
+                fi;
+                k = 0
+            }
+        :: true ->
+            /* SSD evictor (background.rs:313-349): get_evictable_offset
+             * (lookup BlockDevice -> offset, l.384-404), mt.remove,
+             * dm.remove (continue on Err, l.331-333), remove_extent. */
+            atomic {
+                k = 0;
+                do
+                :: (k < N_CLIENTS - 1) -> k++
+                :: true -> break
+                od;
+                if
+                :: (dm_loc[k] == BLOCK) -> off = dm_off[k]
+                :: else -> off = NO_OFF; k = 0
+                fi
+            };
+            if
+            :: (off != NO_OFF) ->
+                atomic {
+                    if
+                    :: (dm_loc[k] != NONE && dm_rref[k] == 0) ->
+                        dm_loc[k] = NONE;
+                        dm_off[k] = NO_OFF
+                    :: else -> off = NO_OFF
+                    fi
+                };
+                if
+                :: (off != NO_OFF && !no_drives) -> remove_extent(off, k)
+                :: else -> skip
+                fi
+            :: else -> skip
+            fi
+        :: true ->
+            /* checkpoint timer (extent-manager set_checkpoint_interval) */
+            checkpoint()
+        fi;
+        k = 0; off = 0
+    :: shutdown -> break
+    od;
+    evictor_done = true
+}
+
+/* ---------- Initialization ---------- */
+init
+{
+    byte i;
+    byte ci;
+
+    d_step {
+        i = 0;
+        do
+        :: (i < N_EXTENTS) ->
+            extent_state[i] = FREE;
+            extent_owner[i] = 0;
+            extent_key[i] = NO_OFF;
+            i++
+        :: else -> break
+        od;
+        i = 0;
+        do
+        :: (i < N_CLIENTS) ->
+            dm_loc[i] = NONE;
+            dm_off[i] = NO_OFF;
+            dm_rref[i] = 0;
+            i++
+        :: else -> break
+        od;
+        last_reserve = R_OK; last_publish = R_OK; last_convert = R_OK;
+        last_release = R_OK; last_rm_ext = R_OK
+    };
+
+    /* Configuration: data drives present or not (lib.rs:1407). */
+    if
+    :: no_drives = false
+    :: no_drives = true
+    fi;
+
+    atomic {
+        run BgWriter();
+        run Evictor();
+        i = 0;
+        do
+        :: (i < N_CLIENTS) -> run Client(i); i++
+        :: else -> break
+        od
+    };
+
+    (clients_done == N_CLIENTS);
+
+    /* IDispatcher::shutdown (lib.rs:2112-2137): evictors first (l.2115-2121),
+     * then the writer drains (l.2123-2125, background.rs:108-115), then
+     * checkpoint every extent manager (l.2128-2137). */
+    shutdown = true;
+    evictor_done;
+    writer_done;
+    checkpoint();
+
+    d_step {
+        i = 0;
+        do
+        :: (i < N_EXTENTS) ->
+            /* P1: nothing stuck in RESERVED. */
+            assert(extent_state[i] != RESERVED);
+            /* P2 (legacy): ABORTED is never a resting state. */
+            assert(extent_state[i] != ABORTED);
+            /* P7: no orphaned published extent. */
+            assert(extent_state[i] != PUBLISHED ||
+                   (extent_key[i] < N_CLIENTS &&
+                    (dm_loc[extent_key[i]] == MT_SSD || dm_loc[extent_key[i]] == BLOCK) &&
+                    dm_off[extent_key[i]] == i));
+            i++
+        :: else -> break
+        od;
+        i = 0;
+        do
+        :: (i < N_CLIENTS) ->
+            /* P6 at rest: every SSD offset in the map is i's published extent. */
+            assert(no_drives || dm_off[i] == NO_OFF ||
+                   (extent_state[dm_off[i]] == PUBLISHED && extent_key[dm_off[i]] == i));
+            i++
+        :: else -> break
+        od
+    }
+}
diff -ruN '--exclude=*.trail' '--exclude=*.log' '--exclude=*.txt' '--exclude=trails' '--exclude=control' '--exclude=bug2' '--exclude=RESULT.md' orig/no-lost-extents/no_lost_extents.pml no-lost-extents/no_lost_extents.pml
--- orig/no-lost-extents/no_lost_extents.pml	2026-10-17 00:05:41.900414148 -0700
+++ no-lost-extents/no_lost_extents.pml	2026-10-17 00:50:33.258071918 -0700
@@ -2,28 +2,65 @@
